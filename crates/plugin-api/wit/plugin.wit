// What a plugin and the editor say to each other. Once released, version 2 only
// grows in ways plugins built against it can't notice; anything else is version 3.
// Version 2 added what a plugin's language servers start with (`server-env`,
// `server-settings`, `which`), and panels beside a file (`panel-open` and the rest).
package ghostwrite:plugin@2.0.0;

interface types {
    // The file a plugin is asked about, as it is now. Offsets are bytes into `text`.
    record context {
        root: string,
        path: option<string>,
        language: option<string>,
        text: string,
        cursor: u64,
        selection-start: u64,
        selection-end: u64,
    }

    enum event {
        opened,
        saved,
        closed,
    }

    // Replace `start..end` of the text it was shown. All of a reply's edits are about
    // that same text, and are one undo step.
    record edit {
        start: u64,
        end: u64,
        text: string,
    }

    variant action {
        // A line for the status bar.
        say(string),
        edit(edit),
        // Open a file of the project, relative to its root.
        open(string),
    }

    // Part of a file to color: `scope` is `keyword`, `string`, `text.title` and so on.
    record span {
        start: u32,
        end: u32,
        scope: string,
    }

    // A glyph's box on a page, in points from its top left, and the bytes of the
    // text it came from, if it did.
    record glyph {
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        source: option<tuple<u32, u32>>,
    }

    // A page laid out. Its key says what's on it: the same key, the same drawing.
    record page {
        width: f32,
        height: f32,
        key-high: u64,
        key-low: u64,
        glyphs: list<glyph>,
    }

    // What of a page to draw: the page drawn `scale` pixels to a point, and of
    // that, `width` by `height` pixels from `x`, `y` (its top left is 0, 0). The
    // whole page is the region from 0, 0 as big as it is at that scale; zoomed in,
    // the editor asks for the parts on screen.
    record region {
        scale: f32,
        x: u32,
        y: u32,
        width: u32,
        height: u32,
    }

    // A region drawn: exactly as wide and as high as it, a row at a time, four
    // bytes a pixel, blue, green, red and alpha (premultiplied). What's past the
    // page's edge is see-through.
    record drawing {
        width: u32,
        height: u32,
        bgra: list<u8>,
    }

    // In the code's font; lines starting `stands-out`, if anything, stand out.
    record code-block {
        text: string,
        stands-out: option<char>,
    }

    // A part of what a panel shows.
    variant block {
        heading(string),
        code(code-block),
        // Something good, in a word.
        good(string),
        muted(string),
    }

    // A panel beside a file, as it is now. `state` is what the plugin keeps about it,
    // as it likes: the editor holds it for that file, and hands it back with the
    // next call about its panel.
    record panel {
        state: string,
        blocks: list<block>,
        // The first line its server is still working on, if it's said.
        working-on: option<u32>,
    }
}

// What the editor does for a plugin, as far as its manifest says it may.
interface host {
    // Download from a host its `access.network` lists, over https.
    fetch: func(url: string) -> result<list<u8>, string>;
    // Where a program is, on the PATH it's been given (`access.env`), if it's there.
    which: func(program: string) -> option<string>;
}

world plugin {
    use types.{context, event, action, span, page, region, drawing, panel};

    import host;

    // Run one of the commands its manifest lists.
    export run: func(name: string, args: list<string>, context: context) -> result<list<action>, string>;
    // Something it asked for in its manifest has happened.
    export on-event: func(event: event, context: context) -> result<list<action>, string>;
    // What to color in this text, in order, if its manifest's `"highlights"` says it does.
    export highlight: func(text: string) -> list<span>;
    // Get ready to make pages of the file at `path`, in the project (mounted at
    // /project if `access.project` says so). Local time is `utc-offset-minutes` from UTC.
    export open-pages: func(path: string, utc-offset-minutes: s32) -> result<_, string>;
    // Pages from the file's text as it is now.
    export make-pages: func(text: string) -> result<list<page>, string>;
    // Draw `region` of the page with this key, of the last pages made or the ones before.
    export draw: func(key-high: u64, key-low: u64, region: region) -> option<drawing>;
    // What a server of its own starts with, if its manifest says the plugin's code
    // configures it: environment variables, over those it would have. `project` is the
    // project's folder (at /project, if `access.project` says so) and `root` the folder
    // in it the server's started in, both as the editor knows them. The variables
    // `access.env` lists are as the server would have them.
    export server-env: func(server: string, project: string, root: string) -> list<tuple<string, string>>;
    // Its answer to that server's `workspace/configuration` for `section`, as JSON, if any.
    export server-settings: func(server: string, project: string, root: string, section: string) -> option<string>;
    // The panel beside a file of `language`, if its manifest's `"panel"` says it has
    // one, before its server's been asked anything.
    export panel-open: func(language: string) -> panel;
    // The server's answers to the panel's `requests` about the cursor, in that order,
    // as JSON, each unless it failed or was empty.
    export panel-answered: func(state: string, answers: list<option<string>>) -> panel;
    // A notification of the server's about the file, one the panel's `notifications`
    // lists, its params as JSON. `true`: ask its requests again.
    export panel-notification: func(state: string, method: string, params: string) -> tuple<panel, bool>;
}
